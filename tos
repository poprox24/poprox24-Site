		function renderOneMessage(msg, scroll = true) {
			const me = loadClient();
			const isMe = me && me.client_id === msg.client_id;

			const div = document.createElement('div');
			div.className = `msg-bubble ${isMe ? 'msg-out' : 'msg-in'}`;

			const created = msg.created_at ? new Date(msg.created_at) : new Date();
			const timeStr = new Intl.DateTimeFormat(navigator.language || undefined, {
				year: 'numeric', month: 'short', day: '2-digit',
				hour: '2-digit', minute: '2-digit'
			}).format(created);

			const meta = !isMe
				? `<span class="msg-meta"><strong>${escapeHtml(msg.author_name || 'Anon')}</strong> • ${escapeHtml(timeStr)}</span>`
				: `<span class="msg-meta">${escapeHtml(timeStr)}</span>`;

			const delBtn = isMe ? `<button class="msg-del" data-id="${msg.id}">×</button>` : '';

			div.innerHTML = `${meta}${escapeHtml(msg.content)}${delBtn}`;
			commentsList.appendChild(div);

			if (scroll) commentsList.scrollTop = commentsList.scrollHeight;
		}

		async function refreshComments() {
			const msgs = await apiFetchComments();
			commentsList.innerHTML = '';
			msgs.forEach(m => renderOneMessage(m, false));
			commentsList.scrollTop = commentsList.scrollHeight;
		}

		commentsList.addEventListener('click', async (e) => {
			if (e.target.classList.contains('msg-del')) {
				const id = e.target.dataset.id;
				if (confirm('Delete message?')) {
					await apiDeleteComment(id);
					refreshComments();
				}
			}
		});

		function startPolling() {
			if (pollingInterval) clearInterval(pollingInterval);
			pollingInterval = setInterval(refreshComments, 30000);
		}
		function stopPolling() {
			if (pollingInterval) clearInterval(pollingInterval);
		}

		const escapeHtml = s => String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

		function isMobile() {
			return /Mobi|Android|iPhone|iPad|iPod/i.test(navigator.userAgent) || window.innerWidth < 790;
		}
		if (!isMobile()) {
			if (!isOpen) {
				rootBtn.classList.add('no-anim');
				void rootBtn.offsetWidth;
				rootBtn.classList.add('open');
				isOpen = true;
				checkUserStatus();
				startPolling();
				setTimeout(() => rootBtn.classList.remove('no-anim'), 60);
			}
		}

		});
		</script>
	</body>
</html>